# syntax=docker/dockerfile:1
#
# Backend (instareels-api) — runs the full Next.js app including app/api/*.
# This is the only deployment that needs ffmpeg/ffprobe (TTS duration
# probing, video probing, thumbnails, OCR frame extraction) and writes job
# data under WORK_DIR.

FROM node:24-bookworm-slim AS base

# ---- dependencies -----------------------------------------------------
# --ignore-scripts: one of our deps (msedge-tts) ships a preinstall script
# that hard-fails unless run through pnpm; none of our deps need their
# install scripts to run for functionality, so scripts are skipped entirely.
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# ---- build --------------------------------------------------------------
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# ---- runtime --------------------------------------------------------------
# A full node_modules is copied in (rather than next's standalone/traced
# output) because tesseract.js loads its worker script through requires the
# file tracer can't follow, which silently drops transitive deps like bmp-js.
FROM base AS runner
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
# Ephemeral by default (matches Railway's non-Volume filesystem) and
# world-writable, so no explicit chown is needed for any uid. Point this at
# a mounted Railway Volume path later for persistence, e.g. WORK_DIR=/data —
# Railway always mounts volumes as root:root, so docker-entrypoint.api.sh
# chowns WORK_DIR at container start before dropping to "nextjs" below.
ENV WORK_DIR=/tmp/instareels

RUN groupadd --system --gid 1001 nodejs \
 && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY package.json next.config.ts proxy.ts ./
COPY docker-entrypoint.api.sh /docker-entrypoint.api.sh
RUN chmod +x /docker-entrypoint.api.sh

EXPOSE 3000

# Stays root here (no USER) so the entrypoint can chown a freshly-mounted
# Volume before it execs into "nextjs" — see docker-entrypoint.api.sh.
ENTRYPOINT ["/docker-entrypoint.api.sh"]

# Railway injects PORT; `next start` reads it directly. -H 0.0.0.0 makes the
# server reachable from outside the container instead of localhost-only.
CMD ["node_modules/.bin/next", "start", "-H", "0.0.0.0"]
