# Copy to .env.local for local development. Never commit real values.
# All variables below have safe local-dev defaults except where noted.

# --- Shared ---------------------------------------------------------------

# Port the Next.js server listens on. Railway injects this automatically;
# only set it manually for local runs that need a non-default port.
PORT=3000

# --- Backend (instareels-api) ----------------------------------------------

# Where job data (TTS audio, cover images, uploaded sources, thumbnails, OCR frames) is
# written. Defaults to ./data locally. On Railway this is ephemeral unless
# you mount a Volume and point this at its mount path (e.g. /data).
WORK_DIR=/tmp/instareels

# Comma-separated list of frontend origins allowed to call this API's
# /api/* routes (CORS). Not needed for local dev — localhost is always
# allowed automatically when NODE_ENV != production.
FRONTEND_URL=https://instareels-web.up.railway.app

# Only needed if ffmpeg/ffprobe aren't on PATH under their default names.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Server-only. Used to call ElevenLabs' TTS-with-timestamps API when a user
# turns the ElevenLabs toggle on. Never exposed to the client bundle.
# ELEVENLABS_API_KEY=

# Optional. Defaults to eleven_multilingual_v2 (good Korean quality, supports
# the /with-timestamps endpoint) if unset.
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# The registered-Voice registry (voices/elevenlabs.json) is persisted in the
# same Railway Bucket the BGM library uses — see BGM_BUCKET/BGM_ENDPOINT/
# BGM_REGION/BGM_ACCESS_KEY_ID/BGM_SECRET_ACCESS_KEY already required for BGM.

# Background job queue (TTS/analyze/render run on a worker started via
# instrumentation.ts, not inline in the request — see src/queue). Only set
# this on instareels-api; leaving it unset on instareels-web is what stops
# that deployment from also trying to start a worker. Point it at a
# Railway Redis service with a persistent Volume (AOF, `--appendonly yes`)
# so queued/in-flight jobs survive a Redis restart.
# REDIS_URL=redis://instareels-redis.railway.internal:6379

# Optional. Caps retries for transient errors (network/API blips) before a
# background job is marked FAILED; 0-5, defaults to 2. Logic/validation
# errors never retry regardless of this value — see src/queue/retry.ts.
# QUEUE_MAX_RETRIES=2

# Optional. How many background jobs this worker processes at once. Keep
# at the default of 1 unless the container has CPU/memory headroom for
# concurrent ffmpeg renders.
# WORKER_CONCURRENCY=1

# Web Push (VAPID). Generate once with `npx web-push generate-vapid-keys`
# and never rotate casually — every browser subscription is tied to the
# public key it was created with. Private key is server-only; the matching
# public key must also be set as NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY below
# on instareels-web. Subject is a mailto: or https: URL identifying this app.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=https://instareels-web.up.railway.app

# --- Frontend (instareels-web) ---------------------------------------------

# Base URL of the deployed backend API. Baked into the client bundle at
# BUILD time (Next.js inlines NEXT_PUBLIC_* vars), so this must be set
# before `next build` runs, not just at container start. Leave empty for
# local dev to use same-origin relative /api/* calls.
NEXT_PUBLIC_API_URL=https://instareels-api.up.railway.app

# The VAPID PUBLIC key only (see WEB_PUSH_VAPID_PUBLIC_KEY above) — safe to
# expose, it's how the browser verifies push messages came from our server.
# Same build-time-ARG requirement as NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
